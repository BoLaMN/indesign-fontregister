// FontReg -- shim over the InDesign SDK's shared build settings.
//
// Our project lives outside the SDK tree, so we pull in the SDK's settings and
// then re-point ID_SDK_ROOT at the SDK. xcconfig variable references resolve
// lazily, so every $(ID_SDK_ROOT)/... path inherited above picks this up.
//
// Convention: the SDK is expected at <repo>/sdk. Override ID_SDK_ROOT here (or
// in the environment) if you keep it elsewhere.

#include "../../../../sdk/build/mac/prj/_shared_build_settings/plugin.sdk.xcconfig"

ID_SDK_ROOT = ../../../sdk

// The SDK derives its link-time search paths from ID_PRJ_DIR (the *project*
// directory), which for us is this repo -- so they'd point at a build folder we
// don't have. InDesignModel.framework and libPublicPlugIn.a ship inside the
// SDK, so re-root just these three at the SDK's build folder. Build *output*
// deliberately still lands in this repo (ID_BUILT_SDK_SAMPLES_DIR is untouched).
ID_SDK_BUILDFOLDER   = $(ID_SDK_ROOT)/build/mac/$(ID_BUILDFOLDER_SUBPATH)
ID_DYLIBS_RELDIR     = $(ID_SDK_BUILDFOLDER)/packagefolder/contents/macos
ID_STATICLIBS_RELDIR = $(ID_SDK_BUILDFOLDER)/packagefolder/contents/macos/libs
ID_FRAMEWORKS_RELDIR = $(ID_SDK_BUILDFOLDER)/packagefolder/contents/Frameworks
